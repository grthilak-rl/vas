# Development environment configuration
# Copy this file to .env and update with your server's IP address

# Server IP address (optional - will use browser's current host if not set)
# Only needed if accessing dev server from a different machine
REACT_APP_SERVER_IP=YOUR_SERVER_IP

# Backend API URL (optional - auto-constructed from REACT_APP_SERVER_IP)
REACT_APP_API_URL=http://YOUR_SERVER_IP:8000/api

# Janus WebSocket URL (optional - auto-constructed from REACT_APP_SERVER_IP)
REACT_APP_JANUS_WS_URL=ws://YOUR_SERVER_IP/janus-ws

# Development server port
PORT=3002
